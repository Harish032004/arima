<link rel="stylesheet" href="assets/css/arima-perf-products-v63.css?v=63">










<style id="arima-product-images-v141-css">
.product-card.arima-has-product-image .product-image {
    overflow: hidden;
}

.product-card.arima-has-product-image .product-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
