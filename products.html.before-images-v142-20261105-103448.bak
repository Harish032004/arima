<script id="arima-fullscreen-loader-v54-js">
(function(){
  'use strict';
  var root=document.getElementById('arima-fullscreen-loader-v54');
  var video=document.getElementById('arima-fullscreen-video-v54');
  if(video && window.matchMedia && window.matchMedia('(max-width:767px) and (orientation:portrait)').matches){
    video.poster='assets/media/arima-products-water-treatment-mobile-v60.jpg?v=60';
  }
  var skip=document.getElementById('arima-fullscreen-skip-v54');
  if(!root||!video)return;
  var done=false;
  var timeout=setTimeout(finish,2500);
  function finish(){
    if(done)return;done=true;clearTimeout(timeout);
    root.classList.add('ar54-out');
    try{video.pause();}catch(e){}
    setTimeout(function(){if(root.parentNode)root.parentNode.removeChild(root);},350);
  }
  if(skip)skip.addEventListener('click',finish,{once:true});
  if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches){finish();return;}
  video.addEventListener('ended',finish,{once:true});
  video.addEventListener('error',finish,{once:true});
  var p=video.play();if(p&&typeof p.catch==='function')p.catch(function(){setTimeout(finish,650);});
})();
</script>
