<!-- ARIMA NAVBAR ACTIVE FIX V2 START -->
<script>
(function () {
    "use strict";

    const sections = [
        "home",
        "about",
        "products",
        "applications",
        "industries",
        "contact"
    ];

    function getPage() {
        const path = decodeURIComponent(
            window.location.pathname
        ).toLowerCase();

        const filename = path.split("/").pop();

        if (
            path.includes("/product-pages/") ||
            filename === "products.html"
        ) {
            return "products";
        }

        if (filename === "dosage-calculator.html") {
            return "calculator";
        }

        if (filename === "login.html") {
            return "login";
        }

        if (filename === "index.html" || filename === "") {
            return "home";
        }

        return "";
    }

    function activate(name) {
        document.querySelectorAll(".nav-link").forEach(link => {
            const href = (
                link.getAttribute("href") || ""
            ).toLowerCase();

            const target = href.includes("#")
                ? href.split("#").pop()
                : "";

            const active = target === name && !!name;

            link.classList.toggle("active", active);

            if (active) {
                link.setAttribute("aria-current", "page");
            } else {
                link.removeAttribute("aria-current");
            }
        });

        document.querySelectorAll(
            ".nav-calculator, .nav-login"
        ).forEach(link => {
            const active =
                (name === "calculator" &&
                 link.classList.contains("nav-calculator")) ||
                (name === "login" &&
                 link.classList.contains("nav-login"));

            link.classList.toggle("active", active);

            if (active) {
                link.setAttribute("aria-current", "page");
            } else {
                link.removeAttribute("aria-current");
            }
        });
    }

    function updateHome() {
        let active = "home";

        const header = document.querySelector("header");
        const offset = header
            ? header.getBoundingClientRect().height + 120
            : 200;

        sections.forEach(id => {
            const section = document.getElementById(id);

            if (
                section &&
                section.getBoundingClientRect().top <= offset
            ) {
                active = id;
            }
        });

        activate(active);
    }

    function init() {
        const page = getPage();

        if (page !== "home") {
            activate(page);
            return;
        }

        updateHome();

        let scheduled = false;

        window.addEventListener("scroll", function () {
            if (scheduled) return;

            scheduled = true;

            requestAnimationFrame(function () {
                scheduled = false;
                updateHome();
            });
        }, { passive: true });

        window.addEventListener("hashchange", function () {
            setTimeout(updateHome, 100);
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
})();
</script>
<!-- ARIMA NAVBAR ACTIVE FIX V2 END -->
