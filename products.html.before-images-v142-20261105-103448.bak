<style id="arima-contact-card-highlight-upgrade">
        /* =========================================================
   CONTACT TEXT SIZE UPGRADE
========================================================= */

        .contact-item strong {
            font-size: 12.5px !important;
            font-weight: 800 !important;
            line-height: 1.35 !important;
        }

        .contact-item span {
            font-size: 11.5px !important;
            line-height: 1.5 !important;
            margin-top: 4px !important;
        }

        .contact-icon {
            width: 40px !important;
            height: 40px !important;
            font-size: 14px !important;
        }


        /* =========================================================
   STRONGER PREMIUM CARD HIGHLIGHT
========================================================= */

        .product-card,
        .application-card,
        .why-card,
        .about-feature {
            position: relative !important;
            isolation: isolate !important;

            overflow: hidden !important;

            border:
                1px solid rgba(8, 120, 238, .10) !important;

            background:
                linear-gradient(145deg,
                    #ffffff 0%,
                    #fbfdff 100%) !important;

            transition:
                transform .42s cubic-bezier(.2, .8, .2, 1),
                box-shadow .42s ease,
                border-color .42s ease,
                background .42s ease !important;
        }


        /* animated gradient border glow */

        .product-card::before,
        .application-card::before,
        .why-card::before,
        .about-feature::before {

            content: "" !important;

            position: absolute !important;
            inset: -1px !important;

            border-radius: inherit !important;

            padding: 1px !important;

            background:
                linear-gradient(120deg,
                    rgba(8, 120, 238, 0),
                    rgba(8, 120, 238, .15),
                    rgba(18, 211, 225, .65),
                    rgba(8, 120, 238, .70),
                    rgba(8, 120, 238, 0)) !important;

            background-size: 250% 250% !important;

            opacity: 0 !important;

            z-index: -2 !important;

            transition:
                opacity .4s ease !important;

            animation:
                arimaCardBorderFlow 3.2s linear infinite !important;

            -webkit-mask:
                linear-gradient(#fff 0 0) content-box,
                linear-gradient(#fff 0 0) !important;

            -webkit-mask-composite: xor !important;

            mask-composite: exclude !important;

            pointer-events: none !important;
        }

        @keyframes arimaCardBorderFlow {

            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }

        }


        /* soft internal glow */

        .product-card::after,
        .application-card::after,
        .why-card::after,
        .about-feature::after {

            content: "" !important;

            position: absolute !important;

            width: 220px !important;
            height: 220px !important;

            top: -120px !important;
            right: -110px !important;

            border-radius: 50% !important;

            background:
                radial-gradient(circle,
                    rgba(54, 217, 238, .28) 0%,
                    rgba(8, 120, 238, .12) 40%,
                    transparent 72%) !important;

            opacity: 0 !important;

            transform: scale(.55) !important;

            transition:
                opacity .45s ease,
                transform .55s ease !important;

            z-index: -1 !important;

            pointer-events: none !important;
        }


        /* MAIN HOVER */

        .product-card:hover,
        .application-card:hover,
        .why-card:hover,
        .about-feature:hover {

            transform:
                translateY(-12px) scale(1.018) !important;

            border-color:
                rgba(8, 120, 238, .45) !important;

            background:
                linear-gradient(145deg,
                    #ffffff 0%,
                    #f4fbff 100%) !important;

            box-shadow:
                0 28px 65px rgba(4, 52, 90, .18),

                0 0 0 1px rgba(20, 194, 225, .12),

                0 0 30px rgba(8, 120, 238, .10) !important;
        }


        .product-card:hover::before,
        .application-card:hover::before,
        .why-card:hover::before,
        .about-feature:hover::before {

            opacity: 1 !important;
        }


        .product-card:hover::after,
        .application-card:hover::after,
        .why-card:hover::after,
        .about-feature:hover::after {

            opacity: 1 !important;

            transform:
                scale(1.35) !important;
        }


        /* =========================================================
   PRODUCT CARD STRONG HOVER
========================================================= */

        .product-card .product-image {
            position: relative !important;
        }

        .product-card .product-image img {

            transition:
                transform .75s cubic-bezier(.2, .8, .2, 1),
                filter .5s ease !important;
        }

        .product-card:hover .product-image img {

            transform:
                scale(1.11) !important;

            filter:
                saturate(1.15) contrast(1.05) brightness(1.03) !important;
        }

        .product-card h3 {

            transition:
                color .35s ease,
                transform .35s ease !important;
        }

        .product-card:hover h3 {

            color: #0878ee !important;

            transform:
                translateX(4px) !important;
        }

        .product-card .product-link {

            transition:
                background .35s ease,
                color .35s ease,
                border-color .35s ease,
                gap .35s ease,
                box-shadow .35s ease !important;
        }

        .product-card:hover .product-link {

            background:
                linear-gradient(135deg,
                    #0878ee,
                    #0ca8e5) !important;

            color: #fff !important;

            border-color: transparent !important;

            gap: 12px !important;

            box-shadow:
                0 9px 24px rgba(8, 120, 238, .22) !important;
        }


        /* =========================================================
   APPLICATION CARD STRONG HOVER
========================================================= */

        .application-card .application-image img {

            transition:
                transform .72s ease,
                filter .5s ease !important;
        }

        .application-card:hover .application-image img {

            transform:
                scale(1.11) !important;

            filter:
                saturate(1.18) contrast(1.05) brightness(1.03) !important;
        }

        .application-card h3 {

            transition:
                color .35s ease,
                transform .35s ease !important;
        }

        .application-card:hover h3 {

            color: #0878ee !important;

            transform:
                translateX(4px) !important;
        }

        .application-card .app-arrow {

            transition:
                transform .4s cubic-bezier(.2, .8, .2, 1),
                background .35s ease,
                color .35s ease,
                box-shadow .35s ease !important;
        }

        .application-card:hover .app-arrow {

            background:
                linear-gradient(135deg,
                    #0878ee,
                    #18cbe0) !important;

            color: #fff !important;

            border-color: transparent !important;

            transform:
                rotate(-35deg) scale(1.14) !important;

            box-shadow:
                0 10px 25px rgba(8, 120, 238, .28) !important;
        }


        /* =========================================================
   WHY CARD STRONG HOVER
========================================================= */

        .why-card .why-icon {

            transition:
                transform .5s cubic-bezier(.2, .8, .2, 1),
                box-shadow .4s ease,
                filter .4s ease !important;
        }

        .why-card:hover .why-icon {

            transform:
                translateY(-5px) rotate(-8deg) scale(1.15) !important;

            filter:
                brightness(1.08) !important;

            box-shadow:
                0 15px 34px rgba(8, 120, 238, .30) !important;
        }

        .why-card h3 {

            transition:
                color .35s ease,
                transform .35s ease !important;
        }

        .why-card:hover h3 {

            color: #0878ee !important;

            transform:
                translateY(-2px) !important;
        }


        /* =========================================================
   ABOUT FEATURE HOVER
========================================================= */

        .about-feature .about-feature-icon {

            transition:
                transform .45s ease,
                color .35s ease,
                background .35s ease,
                box-shadow .35s ease !important;
        }

        .about-feature:hover .about-feature-icon {

            color: #fff !important;

            background:
                linear-gradient(135deg,
                    #0878ee,
                    #19c8df) !important;

            transform:
                rotate(-7deg) scale(1.12) !important;

            box-shadow:
                0 12px 28px rgba(8, 120, 238, .25) !important;
        }

        .about-feature h4 {

            transition:
                color .35s ease !important;
        }

        .about-feature:hover h4 {

            color: #0878ee !important;
        }


        /* =========================================================
   TOUCH DEVICES
========================================================= */

        @media(hover:none) {

            .product-card:hover,
            .application-card:hover,
            .why-card:hover,
            .about-feature:hover {

                transform: none !important;
            }

        }
    </style>
<style id="arima-why-card-line-fix">
        /* =========================================================
   WHY CHOOSE ARIMA - CLEAN HOVER FIX
   removes the visible animated line/border artifact
========================================================= */

        .why-card::before {
            display: none !important;
        }

        .why-card::after {
            content: "" !important;

            position: absolute !important;

            width: 220px !important;
            height: 220px !important;

            top: -120px !important;
            right: -110px !important;

            border-radius: 50% !important;

            background:
                radial-gradient(circle,
                    rgba(41, 218, 236, .26) 0%,
                    rgba(8, 120, 238, .10) 42%,
                    transparent 72%) !important;

            opacity: 0 !important;

            transform: scale(.55) !important;

            transition:
                opacity .45s ease,
                transform .55s ease !important;

            pointer-events: none !important;

            z-index: -1 !important;
        }

        .why-card:hover::after {
            opacity: 1 !important;

            transform:
                scale(1.4) !important;
        }

        .why-card:hover {
            transform:
                translateY(-10px) scale(1.015) !important;

            border-color:
                rgba(8, 120, 238, .38) !important;

            background:
                linear-gradient(145deg,
                    #ffffff 0%,
                    #f3faff 100%) !important;

            box-shadow:
                0 24px 55px rgba(4, 52, 90, .16),

                0 0 26px rgba(18, 190, 225, .10) !important;
        }

        .why-card:hover .why-icon {
            transform:
                translateY(-5px) scale(1.12) !important;

            box-shadow:
                0 14px 30px rgba(8, 120, 238, .28) !important;
        }

        .why-card:hover h3 {
            color: #0878ee !important;
        }
    </style>
<style id="arima-mobile-banner-about-fix">
        /* =========================================================
   REMOVE LOGO OVERLAY FROM ABOUT IMAGE
========================================================= */

        .about-logo-badge {
            display: none !important;
        }


        /* =========================================================
   MOBILE HERO + ABOUT ORDER FIX
========================================================= */

        @media(max-width:800px) {

            /* -----------------------------------------------------
       HERO
       Keep text inside normal content width
       but make image full device width
    ----------------------------------------------------- */

            .hero {
                overflow: hidden !important;
            }

            .hero-layout {
                width: 100% !important;

                display: flex !important;
                flex-direction: column !important;
            }

            .hero-copy {
                order: 1 !important;

                width: 100% !important;

                padding-left: 20px !important;
                padding-right: 20px !important;
            }


            /* FULL BLEED IMAGE */

            .hero-visual {
                order: 2 !important;

                position: relative !important;

                width: 100vw !important;
                max-width: none !important;

                height: 390px !important;
                min-height: 390px !important;

                left: 50% !important;

                margin-left: -50vw !important;
                margin-right: -50vw !important;

                border-radius: 0 !important;

                overflow: hidden !important;
            }

            .hero-image-shell {
                position: absolute !important;

                inset: 0 !important;

                width: 100% !important;
                height: 100% !important;

                border-radius: 0 !important;

                overflow: hidden !important;
            }

            .hero-main-image {
                position: absolute !important;

                inset: 0 !important;

                width: 100% !important;
                height: 100% !important;

                max-width: none !important;

                object-fit: cover !important;
                object-position: center center !important;

                border-radius: 0 !important;

                transform: none !important;
            }


            /* remove any leftover side rounding */

            .hero-image-shell::before,
            .hero-image-shell::after {
                border-radius: 0 !important;
            }


            /* -----------------------------------------------------
       ABOUT SECTION
       CONTENT FIRST -> IMAGE SECOND
    ----------------------------------------------------- */

            .about-layout {
                display: flex !important;

                flex-direction: column !important;

                gap: 35px !important;
            }

            .about-content {
                order: 1 !important;

                width: 100% !important;
            }

            .about-image {
                order: 2 !important;

                width: 100% !important;

                height: 380px !important;

                margin: 0 !important;

                border-radius: 22px !important;
            }

            .about-image img {
                width: 100% !important;
                height: 100% !important;

                object-fit: cover !important;

                border-radius: 22px !important;
            }

        }


        /* =========================================================
   MOBILE
========================================================= */

        @media(max-width:600px) {

            /* HERO IMAGE FULL EDGE TO EDGE */

            .hero-visual {
                width: 100vw !important;

                height: 350px !important;
                min-height: 350px !important;

                left: 50% !important;

                margin-left: -50vw !important;
                margin-right: -50vw !important;

                border-radius: 0 !important;
            }

            .hero-main-image {
                object-position: center center !important;
            }


            /* ABOUT */

            #about {
                padding-top: 70px !important;
            }

            .about-layout {
                gap: 30px !important;
            }

            .about-content {
                order: 1 !important;
            }

            .about-image {
                order: 2 !important;

                height: 330px !important;

                margin-top: 5px !important;

                border-radius: 20px !important;
            }

            .about-image img {
                border-radius: 20px !important;
            }

        }


        /* =========================================================
   SMALL MOBILE
========================================================= */

        @media(max-width:420px) {

            .hero-visual {
                height: 310px !important;
                min-height: 310px !important;
            }

            .about-image {
                height: 290px !important;
            }

        }
    </style>
<style id="arima-mobile-navbar-final-fix">
        /* =========================================================
   PREVENT MOBILE HORIZONTAL SHIFT
========================================================= */

        html,
        body {
            max-width: 100% !important;
            overflow-x: hidden !important;
        }


        /* =========================================================
   MOBILE NAVBAR FINAL FIX
========================================================= */

        @media(max-width:900px) {

            :root {
                --header-height: 68px !important;
            }


            /* HEADER */

            .site-header,
            .site-header.scrolled {

                position: fixed !important;

                top: 0 !important;
                left: 0 !important;
                right: 0 !important;

                width: 100% !important;
                max-width: 100vw !important;

                height: 68px !important;
                min-height: 68px !important;

                margin: 0 !important;
                padding: 0 !important;

                z-index: 99999 !important;

                background:
                    rgba(255, 255, 255, .97) !important;

                backdrop-filter:
                    blur(16px) !important;

                -webkit-backdrop-filter:
                    blur(16px) !important;

                border-bottom:
                    1px solid rgba(5, 45, 75, .08) !important;

                box-shadow:
                    0 6px 24px rgba(4, 35, 60, .08) !important;

                transform: none !important;
            }


            /* NAVBAR WRAPPER */

            .site-header .container,
            .navbar {

                width: 100% !important;
                max-width: 100% !important;

                height: 68px !important;

                margin: 0 !important;

                padding:
                    0 14px !important;

                display: flex !important;

                align-items: center !important;
                justify-content: space-between !important;

                gap: 12px !important;
            }


            /* LOGO */

            .brand-logo,
            .site-header.scrolled .brand-logo {

                width: auto !important;
                max-width: 105px !important;

                height: 56px !important;

                margin: 0 !important;

                display: flex !important;

                align-items: center !important;
                justify-content: flex-start !important;

                overflow: visible !important;

                flex-shrink: 0 !important;
            }


            .brand-logo img,
            .site-header.scrolled .brand-logo img {

                display: block !important;

                width: auto !important;
                max-width: 105px !important;

                height: 50px !important;

                margin: 0 !important;

                object-fit: contain !important;

                transform: none !important;
            }


            /* HAMBURGER */

            .hamburger {

                display: grid !important;

                place-items: center !important;

                width: 42px !important;
                height: 42px !important;

                min-width: 42px !important;

                padding: 0 !important;

                margin: 0 !important;

                border:
                    1px solid #d8e6ef !important;

                border-radius: 11px !important;

                background:
                    #f5f9fc !important;

                color: #082b46 !important;

                font-size: 17px !important;

                cursor: pointer !important;

                position: relative !important;

                z-index: 100002 !important;
            }


            /* =====================================================
       MOBILE DROPDOWN
    ===================================================== */

            .nav-right {

                position: fixed !important;

                top: 68px !important;
                left: 0 !important;
                right: 0 !important;

                width: 100% !important;
                max-width: 100vw !important;

                height: auto !important;
                max-height:
                    calc(100svh - 68px) !important;

                margin: 0 !important;

                padding:
                    18px 18px 22px !important;

                display: flex !important;

                flex-direction: column !important;

                align-items: stretch !important;

                gap: 14px !important;

                overflow-y: auto !important;
                overflow-x: hidden !important;

                background:
                    rgba(255, 255, 255, .99) !important;

                backdrop-filter:
                    blur(20px) !important;

                -webkit-backdrop-filter:
                    blur(20px) !important;

                border-top:
                    1px solid #edf2f5 !important;

                box-shadow:
                    0 20px 45px rgba(4, 36, 60, .13) !important;


                opacity: 0 !important;
                visibility: hidden !important;

                pointer-events: none !important;

                transform:
                    translateY(-12px) !important;

                transition:
                    opacity .28s ease,
                    visibility .28s ease,
                    transform .28s ease !important;

                z-index: 100000 !important;
            }


            .nav-right.open {

                opacity: 1 !important;
                visibility: visible !important;

                pointer-events: auto !important;

                transform:
                    translateY(0) !important;
            }


            /* LINKS */

            .nav-links {

                width: 100% !important;

                display: flex !important;

                flex-direction: column !important;

                align-items: stretch !important;

                gap: 3px !important;

                margin: 0 !important;
                padding: 0 !important;
            }


            .nav-links li {

                width: 100% !important;

                list-style: none !important;
            }


            .nav-link {

                width: 100% !important;

                min-height: 44px !important;

                padding:
                    0 12px !important;

                display: flex !important;

                align-items: center !important;

                border-radius: 9px !important;

                color: #17364f !important;

                font-size: 12px !important;
                font-weight: 700 !important;

                transition:
                    background .25s ease,
                    color .25s ease !important;
            }


            .nav-link::after {

                display: none !important;
            }


            .nav-link:hover,
            .nav-link.active {

                color: #0878ee !important;

                background:
                    #eef7ff !important;
            }


            /* ACTION BUTTONS */

            .nav-actions {

                width: 100% !important;

                display: grid !important;

                grid-template-columns: 1fr !important;

                gap: 9px !important;
            }


            .nav-calculator,
            .nav-login {

                width: 100% !important;

                min-height: 46px !important;

                display: flex !important;

                align-items: center !important;
                justify-content: center !important;

                margin: 0 !important;

                border-radius: 11px !important;

                font-size: 11px !important;
                font-weight: 800 !important;
            }


            .nav-login {

                border:
                    1px solid #d7e6ef !important;

                background:
                    #f8fbfd !important;

                color: #153752 !important;
            }


            /* Ensure page content starts below header */

            .hero {

                margin-top:
                    68px !important;
            }

        }


        /* =========================================================
   SMALL MOBILE
========================================================= */

        @media(max-width:480px) {

            .site-header .container,
            .navbar {

                padding:
                    0 12px !important;
            }


            .brand-logo,
            .site-header.scrolled .brand-logo {

                max-width: 96px !important;
            }


            .brand-logo img,
            .site-header.scrolled .brand-logo img {

                max-width: 96px !important;

                height: 46px !important;
            }


            .hamburger {

                width: 40px !important;
                height: 40px !important;

                min-width: 40px !important;
            }


            .nav-right {

                padding:
                    15px 14px 20px !important;
            }

        }
    </style>
