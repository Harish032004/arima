r.html":"assets/products/prod47.webp","housekeeping-chemicals--tyre-polish.html":"assets/products/prod53.webp","industrial-chemicals--acetic-acid.html":"assets/products/prod30.webp","industrial-chemicals--acetone.html":"assets/products/prod28.webp","industrial-chemicals--acid-slurry.html":"assets/products/prod40.webp","industrial-chemicals--ethyl-acetate.html":"assets/products/prod37.webp","industrial-chemicals--glycerine.html":"assets/products/prod41.webp","industrial-chemicals--hydrogen-peroxide.html":"assets/products/prod42.webp","industrial-chemicals--isopropyl-alcohol.html":"assets/products/prod27.webp","industrial-chemicals--lacquer-thinner.html":"assets/products/prod34.webp","industrial-chemicals--nc-thinner.html":"assets/products/prod32.webp","industrial-chemicals--phosphoric-acid.html":"assets/products/prod31.webp","industrial-chemicals--sles-liquid.html":"assets/products/prod38.webp","industrial-chemicals--sles-paste.html":"assets/products/prod39.webp","industrial-chemicals--sulfamic-acid.html":"assets/products/prod36.webp","industrial-chemicals--toluene.html":"assets/products/prod29.webp","industrial-chemicals--trichloroethylene.html":"assets/products/prod35.webp","ro-treatment-chemicals--biocide.html":"assets/products/prod17.webp","ro-treatment-chemicals--chlorine-tablet.html":"assets/products/prod18.webp","ro-treatment-chemicals--membrane-cleaner.html":"assets/products/prod16.webp","ro-treatment-chemicals--ph-booster.html":"assets/products/prod15.webp","ro-treatment-chemicals--ro-antiscalant.html":"assets/products/prod14.webp","ro-treatment-chemicals--taste-enhancer.html":"assets/products/prod20.webp","spares-equipment--activated-carbon.html":"assets/products/prod58.webp","spares-equipment--cartridge-filter-and-housing.html":"assets/products/prod58.webp","spares-equipment--filter-sand.html":"assets/products/prod60.webp","spares-equipment--frp-vessel.html":"assets/products/prod57.webp","spares-equipment--green-sand.html":"assets/products/prod62.webp","spares-equipment--industrial-ro-membrane.html":"assets/products/prod59.webp","spares-equipment--mbbr-media.html":"assets/products/prod64.webp","spares-equipment--multiport-valve-automatic.html":"assets/products/prod65.webp","spares-equipment--multiport-valve-manual.html":"assets/products/prod56.webp","spares-equipment--silica-sand.html":"assets/products/prod61.webp","spares-equipment--softener-resin.html":"assets/products/prod63.webp","spares-equipment--stainless-steel-storage-tanks.html":"assets/products/prod55.webp","swimming-pool-chemicals--alum-gel.html":"assets/products/prod24.webp","swimming-pool-chemicals--calcium-hypochlorite-granules.html":"assets/products/prod23.webp","swimming-pool-chemicals--copper-sulphate.html":"assets/products/prod26.webp","swimming-pool-chemicals--ph-booster.html":"assets/products/prod15.webp","swimming-pool-chemicals--tcca-90.html":"assets/products/prod22.webp"};

    function getFileName(href) {
        if (!href) return "";

        try {
            const url = new URL(href, window.location.href);
            return decodeURIComponent(
                url.pathname.split("/").pop() || ""
            ).toLowerCase();
        } catch (error) {
            return "";
        }
    }

    function updateImages() {
        const cards = document.querySelectorAll(".product-card");

        cards.forEach(function (card) {
            const links = card.querySelectorAll("a[href]");
            let imagePath = "";

            for (const link of links) {
                const fileName = getFileName(link.getAttribute("href"));

                if (imageMap[fileName]) {
                    imagePath = imageMap[fileName];
                    break;
                }
            }

            if (!imagePath) return;

            const imageContainer = card.querySelector(".product-image");

            if (!imageContainer) return;

            let image = imageContainer.querySelector("img");

            if (!image) {
                image = document.createElement("img");
                imageContainer.prepend(image);
            }

            const desiredURL = new URL(imagePath, window.location.href).href;

            if (image.src !== desiredURL) {
                image.src = desiredURL;
            }

            const heading = card.querySelector("h3");

            image.alt = heading
                ? heading.textContent.trim()
                : "ARIMA Chemical Product";

            image.loading = "lazy";
            image.decoding = "async";

            card.classList.add("arima-has-product-image");
        });
    }

    let scheduled = false;

    function scheduleUpdate() {
        if (scheduled) return;

        scheduled = true;

        requestAnimationFrame(function () {
            scheduled = false;
            updateImages();
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        updateImages();

        const observer = new MutationObserver(scheduleUpdate);

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    });
})();
</script>
